DATABASE_URL="postgresql://user:password@localhost:5432/agence2"
DIRECT_URL="postgresql://user:password@localhost:5432/agence2"
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Setup — required for first-time /api/setup (min 16 chars, one-time use)
# SETUP_SECRET_TOKEN="generate-a-secure-random-token-here"

# Supabase — REQUIRED: use service role key, never the anon key
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Brevo (email)
# BREVO_API_KEY="xkeysib-your-key"
# APP_URL="https://retail-avenue.fr"
# EMAIL_FROM="Retail Avenue <contact@retail-avenue.fr>"

# SEO — referencement de la marque "Retail Avenue"
# Verification de propriete Google Search Console (balise meta google-site-verification).
# Recuperez le code dans Search Console > Ajouter une propriete > Balise HTML.
# GOOGLE_SITE_VERIFICATION="votre-code-de-verification-google"
# Profils officiels (sameAs JSON-LD) — separes par des virgules. Chaque profil
# renforce l'association de l'entite "Retail Avenue" au domaine retail-avenue.fr.
# NEXT_PUBLIC_SOCIAL_LINKS="https://www.linkedin.com/company/retail-avenue,https://www.instagram.com/retailavenue"

# Web Push / Notifications (generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)")
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:contact@votre-agence.fr"

# Proactive cron jobs (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# Set this in the Vercel dashboard *and* make sure the cron definition in
# vercel.json targets /api/cron/daily.
# CRON_SECRET="generate-a-long-random-string"

# AI — Anthropic Claude (business card OCR, listing generation, voice note enrichment)
# Leave empty to disable the AI features; the UI gracefully hides its buttons.
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model used for AI features (defaults to claude-haiku-4-5)
# ANTHROPIC_MODEL="claude-haiku-4-5"

# Seed — only used in development (npm run db:seed)
# SEED_ADMIN_EMAIL="admin@your-agency.fr"
# SEED_ADMIN_PASSWORD="your-strong-password-here"
# SEED_AGENT_EMAIL="agent@your-agency.fr"
# SEED_AGENT_PASSWORD="your-strong-password-here"
